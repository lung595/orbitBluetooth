{
    "$schema": "https://github.com/AvengeMedia/DankMaterialShell/raw/refs/heads/master/PLUGINS/plugin-schema.json",
    "id": "orbitBluetooth",
    "name": "Orbit Bluetooth",
    "description": "A planetary Bluetooth manager: devices float in orbit around your machine, drag one to the center to connect. Headphone noise control, battery time left. Control Center, bar and desktop.",
    "version": "1.3.2",
    "author": "lung595",
    "license": "MIT",
    "icon": "bluetooth",
    "type": "composite",
    "capabilities": [
        "daemon",
        "dankbar-widget",
        "control-center",
        "desktop-widget"
    ],
    "components": {
        "daemon": "./OrbitBluetoothDaemon.qml",
        "widget": "./OrbitBluetoothWidget.qml",
        "desktop": "./OrbitBluetoothDesktop.qml"
    },
    "settings": "./OrbitBluetoothSettings.qml",
    "requires_dms": ">=1.6.0",
    "permissions": [
        "settings_read",
        "settings_write",
        "process"
    ]
}
